@startuml "architecture"

top to bottom direction
skinparam packageStyle rect
allow_mixing

' Draw straight (orthonormal) arrows
skinparam linetype ortho

' Snake-game-inspired color palette
skinparam backgroundColor #FAFAFA
skinparam shadowing false

' Arrow styling (blue-ish arrows, green-ish font)
skinparam ArrowColor #0D47A1
skinparam ArrowThickness 2
skinparam ArrowFontColor #1B5E20

' Package styling (light blue backgrounds)
skinparam package {
  BackgroundColor #BBDEFB
  BorderColor #0D47A1
  FontColor #1B5E20
}

' Class styling (white with blue borders)
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0D47A1
  FontColor #212121
}

' ----------------------------
' Noodle Package
' ----------------------------
package "Noodle Package" {
    package "Model" {
        class GameLogic
        class GameState
        class Snake
        class Fruit
        class Direction
        class Cell
    }

    package "View" {
        class GameRenderer
        class Colors
    }

    package "Controller" {
        class GameController
    }
}

' ----------------------------
' Neural Package
' ----------------------------
package "Neural Package" {
  component train_model

  package visualizations {
    class TrainingPlotter
  }

  package environment {
    class RewardPolicy

    interface GymnasiumEnv
    class SnakeGameEnv implements GymnasiumEnv
  }



}

' ----------------------------
' Noodle Package Dependencies
' ----------------------------
GameController --> GameLogic
GameController --> GameRenderer

GameLogic --> GameState
GameLogic --> Snake
GameLogic --> Fruit
GameLogic --> Direction
GameLogic --> Cell

Snake --> Direction
Snake --> Cell

Fruit --> Cell

GameRenderer --> GameLogic
GameRenderer --> Snake
GameRenderer --> Fruit
GameRenderer --> Colors

' ----------------------------
' Neural Package Dependencies
' ----------------------------
train_model --> visualizations
train_model --> environment
SnakeGameEnv --> GameLogic
SnakeGameEnv --> GameRenderer
SnakeGameEnv --> RewardPolicy

@enduml
